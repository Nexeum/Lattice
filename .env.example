# Lattice — docker compose environment. Copy to .env and adjust.

# JWT signing secret shared by all backend services. CHANGE THIS.
LATTICE_SECRET_KEY=CHANGE_ME

# Comma-separated list of allowed CORS origins for the backend services.
# LATTICE_CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible LLM endpoint for the Tars assistant. Default is Ollama
# (free/local: install from https://ollama.com and `ollama pull llama3.2`).
# LM Studio, llama.cpp, vLLM or hosted providers work too. Under docker
# compose the default is http://host.docker.internal:11434/v1 (host Ollama).
# LATTICE_AI_URL=http://localhost:11434/v1

# Model used by Tars (optional; defaults to llama3.2).
# LATTICE_AI_MODEL=llama3.2

# Optional API key for hosted OpenAI-compatible providers, sent as a Bearer
# token. Ollama ignores it — leave empty for local use.
# LATTICE_AI_KEY=

# Host Docker socket mounted into the `containers` service.
# Docker Desktop / Linux default: /var/run/docker.sock (leave unset).
# colima users: uncomment the line below.
# DOCKER_SOCK=~/.colima/default/docker.sock
